APP_NAME=Philips Product Knowledge AI Agent

LOG_LEVEL=INFO

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_PROVIDER=ollama
OLLAMA_MODEL_TAG=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# TypeSafe Jev query routing (TYPESAFE_API_KEY is the documented name;
# JEV_API_KEY is also accepted by the application).
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# JEV_API_URL=https://api.typesafe.ai/v1/systemone

VECTOR_DB=data/vector_db
DATA_DIRECTORY=data/users

TOP_K=5
SIMILARITY_THRESHOLD=0.75
MAX_CONTEXT_CHUNKS=5

DEVICE=cpu

# PostgreSQL-backed LangGraph conversation checkpoints (Docker Compose)
POSTGRES_DB=philips_agent
POSTGRES_USER=philips_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://philips_agent:replace-with-a-long-random-password@db:5432/philips_agent

# Authentication. Generate a unique JWT_SECRET_KEY (at least 32 characters).
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
# Set true when serving the site over HTTPS; keep false for local HTTP.
AUTH_COOKIE_SECURE=false

# The built-in admin is created at startup; public signup cannot claim this email.
ADMIN_EMAIL=admin@philips
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
